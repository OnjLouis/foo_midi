#include "Resource.h"
#include <winres.h>

IDD_EXTERNAL_MIDI DIALOGEX 0, 0, 290, 146
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MIDI output"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "MIDI &output:", -1, 10, 10, 270, 12
    COMBOBOX IDC_EXTERNAL_MIDI_DEVICE, 10, 25, 270, 130, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Saved output:", -1, 10, 53, 270, 12
    LTEXT "", IDC_EXTERNAL_MIDI_CURRENT, 10, 66, 270, 22
    LTEXT "Listen through the connected instrument's audio output. Foobar's audio volume does not change the instrument's volume.", -1, 10, 90, 270, 26
    DEFPUSHBUTTON "OK", IDOK, 170, 123, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 230, 123, 50, 14
END
